---
import { checkAuthoring } from "./internal/diagnose.js";
import { resolveTone, SWITCH_SIZES, resolveVocab } from "@xtyle/core";
import { renderFragmentLight } from "@xtyle/core/elements/ssr";

import type { FullTone as Tone } from "@xtyle/core";
type Size = (typeof SWITCH_SIZES)[number];

interface Props {
	checked?: boolean;
	disabled?: boolean;
	/** Set false to keep the control out of sequential focus navigation. */
	focusable?: boolean;
	/** Mark this as the one an app-owned keyboard cursor rests on: draws the focus ring without moving focus. */
	cursor?: boolean;
	size?: Size;
	tone?: Tone;
	shape?: "pill" | "square";
	orientation?: "horizontal" | "vertical";
	reverse?: boolean;
	labelSide?: "start" | "end";
	/** Stretch into a full-width row: label at one edge, track at the other. */
	spread?: boolean;
	label?: string;
	labelledby?: string;
	onLabel?: string;
	offLabel?: string;
	name?: string;
	value?: string;
	/** Render zero-JS: emit the resolved light-DOM markup but never load the runtime to hydrate it. */
	static?: boolean;
	class?: string;
	/** Any other attribute (`id`, `title`, `data-*`, `aria-*`, …) passes through to the element. */
	[key: string]: unknown;
}

const {
	checked = false,
	disabled = false,
	focusable,
	cursor = false,
	size: sizeInput,
	tone: toneInput,
	shape = "pill",
	orientation = "horizontal",
	reverse = false,
	labelSide = "start",
	spread = false,
	label,
	labelledby,
	onLabel,
	offLabel,
	name,
	value,
	static: isStatic = false,
	class: extra,
	...rest
} = Astro.props;
await checkAuthoring("switch", Astro.props);
const size = resolveVocab(sizeInput, SWITCH_SIZES, "md", "switch size");
const tone = resolveTone(toneInput, "accent");

const elementId = `xtyle-switch-${Math.random().toString(36).slice(2, 8)}`;

const bindings = {
	checked,
	disabled,
	focusable: focusable ?? true,
	cursor,
	size,
	tone,
	shape,
	orientation,
	reverse,
	labelSide,
	spread,
	label: label ?? null,
	labelledby: labelledby ?? null,
	onLabel: onLabel ?? null,
	offLabel: offLabel ?? null,
	elementId,
};
const light = await renderFragmentLight("switch", bindings);
---

<xtyle-switch
	checked={checked || undefined}
	disabled={disabled || undefined}
	focusable={focusable === false ? "false" : undefined}
	cursor={cursor || undefined}
	size={size}
	tone={tone}
	shape={shape !== "pill" ? shape : undefined}
	orientation={orientation !== "horizontal" ? orientation : undefined}
	reverse={reverse || undefined}
	label-side={labelSide !== "start" ? labelSide : undefined}
	spread={spread || undefined}
	label={label}
	labelledby={labelledby}
	on-label={onLabel}
	off-label={offLabel}
	name={name}
	value={value}
	class={extra}
	set:html={light}
	{...rest}
/>

{!isStatic && <script>import "@xtyle/core/elements";</script>}
