---
import { checkAuthoring } from "./internal/diagnose.js";
import { renderFragmentLight } from "@xtyle/core/elements/ssr";
import { SIZES, resolveVocab } from "@xtyle/core";

type Size = (typeof SIZES)[number];

interface Props {
	label?: string;
	name?: string;
	value?: string;
	size?: Size;
	invalid?: boolean;
	error?: string;
	disabled?: boolean;
	/** Set false to keep the control out of sequential focus navigation. */
	focusable?: boolean;
	required?: boolean;
	requiredMessage?: string;
	ariaLabel?: string;
	/** Render zero-JS: emit the resolved light-DOM markup but never load the runtime to hydrate it. */
	static?: boolean;
	class?: string;
	/** Any other attribute (`id`, `title`, `data-*`, `aria-*`, …) passes through to the element. */
	[key: string]: unknown;
}

const {
	label,
	name,
	value,
	size: sizeInput,
	invalid = false,
	error,
	disabled = false,
	focusable,
	required = false,
	requiredMessage,
	ariaLabel,
	static: isStatic = false,
	class: extra,
	...rest
} = Astro.props;
await checkAuthoring("select", Astro.props);
const size = resolveVocab(sizeInput, SIZES, "md", "select size");

const fieldId = `xtyle-select-${Math.random().toString(36).slice(2, 9)}`;
const errorId = `${fieldId}-error`;

// INFO: the consumer's `<option>`s populate the `<select>` and also ride along as hidden light-DOM
// children (`display:none`) so the element can re-read them on a rebuild
const optionsHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";

const bindings = {
	label: label ?? null,
	value: value ?? null,
	size,
	disabled,
	focusable: focusable ?? true,
	invalid,
	required,
	error: error ?? null,
	name: name ?? null,
	fieldId,
	errorId,
	optionsHtml,
};
const light = await renderFragmentLight("select", bindings);
const composed = light + optionsHtml;
---

<xtyle-select
	label={label}
	value={value}
	size={size}
	name={name}
	disabled={disabled || undefined}
	focusable={focusable === false ? "false" : undefined}
	invalid={invalid || undefined}
	required={required || undefined}
	required-message={requiredMessage}
	error={error}
	aria-label={ariaLabel}
	class={extra}
	set:html={composed}
	{...rest}
/>

{!isStatic && <script>import "@xtyle/core/elements";</script>}
