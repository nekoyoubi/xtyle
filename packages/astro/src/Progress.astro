---
import { checkAuthoring } from "./internal/diagnose.js";
import { renderFragmentLight, composeFallbackSlot } from "@xtyle/core/elements/ssr";

import { rampGradientStops, type FullTone as Tone, type Palette, resolveTone, PROGRESS_VARIANTS, resolveVocab, PROGRESS_SIZES, PROGRESS_RAMP_MODES, PROGRESS_ORIENTS } from "@xtyle/core";
type ProgressVariant = (typeof PROGRESS_VARIANTS)[number];
type ProgressSize = (typeof PROGRESS_SIZES)[number];
type ProgressRampMode = (typeof PROGRESS_RAMP_MODES)[number];
type ProgressOrient = (typeof PROGRESS_ORIENTS)[number];

interface Props {
	variant?: ProgressVariant;
	tone?: Tone;
	size?: ProgressSize;
	value?: number;
	min?: number;
	max?: number;
	indeterminate?: boolean;
	showValue?: boolean;
	/** How `showValue` renders the readout: `percent` (33%), `value` (123), or `value-max` (123/456). */
	valueFormat?: "percent" | "value" | "value-max";
	/** A unit appended to the `value` / `value-max` readout (e.g. `GB`); the `percent` format ignores it. */
	unit?: string;
	/** Tint the readout with the active tone instead of the muted default. */
	colorizeValue?: boolean;
	/** `end` (after the bar) or `inset` (centered in the track, contrast-flipping as the fill crosses). */
	valuePosition?: "end" | "inset";
	/** Report `role="meter"` (a capacity measurement) instead of `role="progressbar"` (a task). */
	meter?: boolean;
	/** Color the fill by its own value along a ramp instead of a flat `tone`: a built-in palette
	 * (`intensity` / `thermal` / `severity`) or an explicit list of stop colors. */
	ramp?: Palette | string[];
	/** How a `ramp` paints: `solid` (one sampled color, needs the runtime) or `gradient` (a pure-CSS
	 * sweep, zero-JS, linear only). Defaults to `solid`. */
	rampMode?: ProgressRampMode;
	/** Flip the ramp end for end (hot-to-cold). */
	reverse?: boolean;
	/** The unfilled groove: `true` for the default rail, `false` to drop it (a ring reporting a window
	 * that may not exist reads better with no groove), or a tone to paint it that tone's `-bg`. */
	track?: boolean | Tone;
	/** How heavy a `circular` ring reads, independent of its diameter: a unitless number in ring units
	 * (scales with the ring) or a CSS length (`6px`) that holds its weight at any size. */
	thickness?: string | number;
	/** The visible caption above the bar, distinct from `aria-label`, which renders nothing. Setting it
	 * alone also names the control, so the string is written once. */
	label?: string;
	/** A free-form reading on the caption line, independent of `valueFormat` (`8/20`, `even`, `46 left`). */
	reading?: string;
	/** A line of prose under the bar, explaining what the reading means. */
	note?: string;
	/** Which axis the bar fills along. `vertical` grows the indicator up the block axis natively, so a
	 * standing gauge needs no rotation. Linear only. */
	orient?: ProgressOrient;
	"aria-label"?: string;
	/** Render zero-JS: emit the resolved light-DOM markup but never load the runtime to hydrate it. */
	static?: boolean;
	class?: string;
	/** Any other attribute (`id`, `title`, `data-*`, `aria-*`, …) passes through to the element. */
	[key: string]: unknown;
}

const {
	variant: variantInput,
	tone: toneInput,
	size: sizeInput,
	value = 0,
	min = 0,
	max = 100,
	indeterminate = false,
	showValue = false,
	valueFormat = "percent",
	unit,
	colorizeValue = false,
	valuePosition = "end",
	meter = false,
	ramp,
	rampMode: rampModeInput,
	reverse = false,
	track = true,
	thickness,
	label,
	reading,
	note,
	orient: orientInput,
	"aria-label": ariaLabel,
	static: isStatic = false,
	class: extra,
	...rest
} = Astro.props;
await checkAuthoring("progress", Astro.props);
const variant = resolveVocab(variantInput, PROGRESS_VARIANTS, "linear", "progress variant");
const size = resolveVocab(sizeInput, PROGRESS_SIZES, "md", "progress size");
const rampMode = resolveVocab(rampModeInput, PROGRESS_RAMP_MODES, "solid", "progress rampMode");
const orient = resolveVocab(orientInput, PROGRESS_ORIENTS, "horizontal", "progress orient");
const tone = resolveTone(toneInput, "accent");
const trackAttr = track === true ? undefined : track === false ? "none" : track;
const thicknessAttr = thickness != null ? String(thickness) : undefined;

// INFO: gradient ramps are pure-CSS var() stops (SSR, zero-JS); a solid ramp samples off the live
// cascade, so SSR leaves the tone and the runtime paints it
const gradientRamp = ramp && rampMode === "gradient" && variant !== "circular";
const rampBindings = ramp
	? gradientRamp
		? { ramp: true, rampMode: "gradient", rampStops: rampGradientStops(ramp, { reverse }) }
		: { ramp: true, rampMode: "solid" }
	: {};

const bindings = {
	variant,
	tone,
	size,
	value,
	min,
	max,
	indeterminate,
	showValue,
	valueFormat,
	unit,
	colorizeValue,
	valuePosition,
	pulse: null,
	track: trackAttr ?? null,
	thickness: thicknessAttr ?? null,
	orient,
	label: label ?? null,
	reading: reading ?? null,
	note: note ?? null,
	hasLabel: Astro.slots.has("label"),
	hasReading: Astro.slots.has("reading"),
	hasNote: Astro.slots.has("note"),
	role: meter ? "meter" : "progressbar",
	ariaLabel: ariaLabel ?? label ?? null,
	ariaLabelledby: null,
	...rampBindings,
};
const light = await renderFragmentLight("progress", bindings);
const valueHtml = Astro.slots.has("value") ? await Astro.slots.render("value") : null;
const labelHtml = Astro.slots.has("label") ? await Astro.slots.render("label") : null;
const readingHtml = Astro.slots.has("reading") ? await Astro.slots.render("reading") : null;
const noteHtml = Astro.slots.has("note") ? await Astro.slots.render("note") : null;
// INFO: the default slot carries `<threshold>` config elements; re-emit them as hidden direct
// children so the hydrating element can read `:scope > threshold`
const thresholdHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const withSlots = composeFallbackSlot(
	composeFallbackSlot(composeFallbackSlot(composeFallbackSlot(light, "value", valueHtml), "label", labelHtml), "reading", readingHtml),
	"note",
	noteHtml,
);
const composed = withSlots + thresholdHtml;
---

<xtyle-progress
	variant={variant}
	tone={tone}
	size={size}
	value={value}
	min={min}
	max={max}
	indeterminate={indeterminate || undefined}
	show-value={showValue || undefined}
	value-format={valueFormat !== "percent" ? valueFormat : undefined}
	unit={unit || undefined}
	colorize-value={colorizeValue || undefined}
	value-position={valuePosition !== "end" ? valuePosition : undefined}
	meter={meter || undefined}
	ramp={ramp ? (Array.isArray(ramp) ? JSON.stringify(ramp) : ramp) : undefined}
	ramp-mode={ramp && rampMode !== "solid" ? rampMode : undefined}
	reverse={reverse || undefined}
	track={trackAttr}
	thickness={thicknessAttr}
	label={label}
	reading={reading}
	note={note}
	orient={orient !== "horizontal" ? orient : undefined}
	aria-label={ariaLabel}
	class={extra}
	set:html={composed}
	{...rest}
/>

{!isStatic && <script>import "@xtyle/core/elements";</script>}
