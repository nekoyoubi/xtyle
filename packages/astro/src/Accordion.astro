---
import { type AccordionSection } from "@xtyle/core/markup";
import { renderFragmentLight } from "@xtyle/core/elements/ssr";
import { authoredPairs } from "./internal/paired-slots.js";
import { checkAuthoring } from "./internal/diagnose.js";
import { SIZES, resolveVocab, iconBody } from "@xtyle/core";

type Size = (typeof SIZES)[number];

interface Props {
	items?: AccordionSection[];
	multiple?: boolean;
	size?: Size;
	headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
	/** The roster glyph drawn as the disclosure marker. */
	chevronIcon?: string;
	/** Render zero-JS: emit the declarative shadow but never load the runtime to hydrate it. */
	static?: boolean;
	class?: string;
	/** Any other attribute (`id`, `title`, `data-*`, `aria-*`, …) passes through to the element. */
	[key: string]: unknown;
}

const {
	items,
	multiple = false,
	size: sizeInput,
	headingLevel,
	chevronIcon,
	static: isStatic = false,
	class: extra,
	...rest
} = Astro.props;

await checkAuthoring("accordion", Astro.props);
const size = resolveVocab(sizeInput, SIZES, "md", "accordion size");

const uid = `xtyle-accordion-${Math.random().toString(36).slice(2, 9)}`;

const authored = items ? [] : await authoredPairs(Astro.slots, "header", "panel");

const sections: AccordionSection[] = items
	? items.map((section, i) => ({ ...section, value: section.value ?? String(i) }))
	: authored.map(({ lead }, i) => ({
			header: "",
			headerSlot: `header-${i}`,
			panel: "",
			panelSlot: `panel-${i}`,
			open: lead.attrs.open !== undefined || lead.attrs["aria-expanded"] === "true",
			disabled: lead.attrs.disabled !== undefined || lead.attrs["aria-disabled"] === "true",
			value: lead.attrs["data-value"] ?? lead.attrs.value ?? String(i),
		}));

const openKeys: string[] = [];
sections.forEach((section, i) => {
	if (!section.open) return;
	const key = section.value ?? String(i);
	if (multiple) openKeys.push(key);
	else if (openKeys.length === 0) openKeys.push(key);
});

const bindings = {
	sections: sections.map((section, i) => ({
		header: section.header,
		headerSlot: section.headerSlot,
		panel: section.panel,
		panelSlot: section.panelSlot,
		value: section.value ?? String(i),
		disabled: section.disabled,
	})),
	openKeys,
	size,
	headingLevel,
	uid,
	multiple,
	chevronIcon: chevronIcon ?? "chevron-down",
	chevronBody: iconBody(chevronIcon ?? "chevron-down") ?? null,
};
const light = sections.length > 0 ? await renderFragmentLight("accordion", bindings) : "";
const composed = authored.reduce(
	(html, pair, i) =>
		html
			.replace(`<slot name="header-${i}"></slot>`, () => pair.lead.html)
			.replace(`<slot name="panel-${i}"></slot>`, () => pair.body?.html ?? ""),
	light,
);
---

<xtyle-accordion
	multiple={multiple || undefined}
	size={size}
	heading-level={headingLevel}
	chevron-icon={chevronIcon}
	items={items ? JSON.stringify(items) : undefined}
	class={extra}
	set:html={composed}
	{...rest}
/>

{!isStatic && <script>import "@xtyle/core/elements";</script>}
