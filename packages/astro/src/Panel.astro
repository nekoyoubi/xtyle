---
import { checkAuthoring } from "./internal/diagnose.js";
import { renderFragmentLight } from "@xtyle/core/elements/ssr";
import { PANEL_VARIANTS, resolveVocab, iconBody } from "@xtyle/core";

type PanelVariant = (typeof PANEL_VARIANTS)[number];

interface Props {
	/** The visible heading. */
	heading?: string;
	/** @deprecated Use `heading` — `title` is the HTML global and paints a browser tooltip. */
	title?: string;
	/** Accessible name for a panel with no visible `title` — names the region without rendering a heading. */
	label?: string;
	level?: 1 | 2 | 3 | 4 | 5 | 6;
	variant?: PanelVariant;
	/** The roster glyph drawn as the collapsible header's marker. */
	markerIcon?: string;
	open?: boolean;
	scroll?: boolean;
	/** Take the remaining height of a bounded parent and scroll the body. */
	fill?: boolean;
	/** Render zero-JS: emit the resolved light-DOM markup but never load the runtime to hydrate it. */
	static?: boolean;
	class?: string;
	/** Any other attribute (`id`, `data-*`, `aria-*`, …) passes through to the element. */
	[key: string]: unknown;
}

const {
	heading,
	title,
	label,
	level = 2,
	variant: variantInput,
	markerIcon,
	open = false,
	scroll = false,
	fill = false,
	static: isStatic = false,
	class: extra,
	...rest
} = Astro.props;
await checkAuthoring("panel", Astro.props);
const variant = resolveVocab(variantInput, PANEL_VARIANTS, "default", "panel variant");

const hasActions = Astro.slots.has("actions");
const hasFooter = Astro.slots.has("footer");
const titleId = `xtyle-panel-${Math.random().toString(36).slice(2, 9)}`;

const resolvedHeading = heading ?? title ?? null;

const bindings = {
	heading: resolvedHeading,
	level,
	variant,
	open,
	scrollable: scroll,
	fill,
	hasActions,
	hasFooter,
	titleId,
	label: label ?? null,
	markerIcon: markerIcon ?? "chevron-right",
	markerBody: iconBody(markerIcon ?? "chevron-right") ?? null,
};
const chrome = await renderFragmentLight("panel", bindings);
const actionsHtml = hasActions ? await Astro.slots.render("actions") : "";
const bodyHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const footerHtml = hasFooter ? await Astro.slots.render("footer") : "";
const composed = chrome
	.replace('<slot name="actions"></slot>', () => actionsHtml)
	.replace('<slot name="footer"></slot>', () => footerHtml)
	.replace("<slot></slot>", () => bodyHtml);
---

<xtyle-panel
	heading={resolvedHeading}
	label={label}
	level={level}
	variant={variant}
	marker-icon={markerIcon}
	open={open || undefined}
	scroll={scroll || undefined}
	fill={fill || undefined}
	class={extra}
	set:html={composed}
	{...rest}
/>

{!isStatic && <script>import "@xtyle/core/elements";</script>}
