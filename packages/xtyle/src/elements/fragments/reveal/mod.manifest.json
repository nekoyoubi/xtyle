{
	"$schema": "https://xript.dev/schema/mod-manifest/v0.8.json",
	"xript": "0.8",
	"name": "xtyle-reveal-default",
	"version": "0.0.1",
	"title": "Xtyle Reveal (default)",
	"description": "The built-in fill for the xtyle Reveal component: the mod-zero markup and behavior every app inherits and may override.",
	"capabilities": ["xtyle.component.reveal"],
	"entry": { "script": "mod.js", "format": "script" },
	"fills": {
		"component.reveal": [
			{
				"id": "reveal",
				"format": "application/x-xtyle+html",
				"source": "reveal.html",
				"handlers": [
					{ "selector": ".xtyle-reveal__lid", "on": "keydown", "handler": "keydown" },
					{ "selector": ".xtyle-reveal__grip", "on": "click", "handler": "grip" }
				],
				"meta": {
					"tokens": [
						"--border-normal",
						"--duration-base",
						"--ease-standard",
						"--fg-2",
						"--layer-raised",
						"--radius-md",
						"--ring",
						"--space-1",
						"--space-2",
						"--space-3",
						"--surface-1",
						"--surface-2"
					]
				}
			}
		]
	}
}
