{
	"$schema": "https://xript.dev/schema/mod-manifest/v0.8.json",
	"xript": "0.8",
	"name": "xtyle-nine-patch-default",
	"version": "0.0.1",
	"title": "Xtyle Nine Patch (default)",
	"description": "The built-in fill for the xtyle Nine Patch component: the mod-zero markup and behavior every app inherits and may override.",
	"capabilities": ["xtyle.component.nine-patch"],
	"entry": { "script": "mod.js", "format": "script" },
	"fills": {
		"component.nine-patch": [
			{
				"id": "nine-patch",
				"format": "application/x-xtyle+html",
				"source": "nine-patch.html",
				"handlers": [],
				"meta": { "tokens": ["--fg-2", "--text-xs", "--font-sans", "--leading-tight"] }
			}
		]
	}
}
