---
import { listComponents, coverComponent } from "@xtyle/core";
import { getStats, displayStats } from "../../data/stats";
import Base from "../../layouts/Base.astro";
import Card from "@xtyle/astro/Card.astro";
import Badge from "@xtyle/astro/Badge.astro";
import Stat from "@xtyle/astro/Stat.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Text from "@xtyle/astro/Text.astro";
import Grid from "@xtyle/astro/Grid.astro";
import Cluster from "@xtyle/astro/Cluster.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Eyebrow from "@xtyle/astro/Eyebrow.astro";
import Separator from "@xtyle/astro/Separator.astro";
import CoverageMeter from "../../components/reference/CoverageMeter.astro";
import CardPreview from "../../components/reference/CardPreview.astro";
import {
	categoryOrder,
	categoryMeta,
} from "../../components/reference/categories.ts";
import { renderMarkdownInline } from "@xtyle/core/markup";
import { isNewComponent } from "../../data/newness.ts";
import { releasedVersions } from "../../data/releases.ts";
import type { ComponentManifest } from "@xtyle/core";

const site = await getStats();
const register = site.register;
const producedCount = site.tokens;

const all = listComponents();
const total = all.length;
const peakFootprint = Math.max(...all.map((c) => c.consumedTokens.length));

const grouped = categoryOrder
	.map((category) => ({
		meta: categoryMeta[category],
		items: all.filter((c) => c.category === category),
	}))
	.filter((g) => g.items.length > 0);


function coverageFor(component: ComponentManifest) {
	const result = coverComponent(component, register);
	return {
		covered: result.covered,
		missing: result.missing,
		consumed: component.consumedTokens.length,
	};
}

/**
 * When each component arrived, newest first.
 *
 * Sorted numerically rather than lexically, because the string sort puts `0.10.0` *below* `0.9.0`
 * and would quietly file the newest release under the oldest — the one bug this data is guaranteed
 * to grow into.
 */
const compareVersions = (a: string, b: string): number => {
	const parse = (v: string) => v.split(".").map((n) => Number.parseInt(n, 10) || 0);
	const [x, y] = [parse(a), parse(b)];
	for (let i = 0; i < Math.max(x.length, y.length); i++) {
		const d = (x[i] ?? 0) - (y[i] ?? 0);
		if (d !== 0) return d;
	}
	return 0;
};

const versions = releasedVersions(all.map((c) => c.since ?? "0.1.0"));
const advent = versions.map((version, i) => ({
	version,
	added: all.filter((c) => (c.since ?? "0.1.0") === version).length,
	total: all.filter((c) => compareVersions(c.since ?? "0.1.0", version) <= 0).length,
	first: i === 0,
}));
const producedSince: Record<string, string> = site.algorithm?.producedSince ?? {};
const tokensAt = (version: string) =>
	Object.keys(register).filter(
		(name) => compareVersions(producedSince[name] ?? "0.1.0", version) <= 0,
	).length;

const scopes = Object.fromEntries(
	versions.map((version) => {
		const existed = all.filter((c) => compareVersions(c.since ?? "0.1.0", version) <= 0);
		return [
			version,
			{
				components: existed.length,
				categories: new Set(existed.map((c) => c.category)).size,
				tokens: tokensAt(version),
				bindings: site.bindings,
			},
		];
	}),
);
const peakAdded = Math.max(...advent.filter((a) => !a.first).map((a) => a.added), 1);

const foundingVersion = versions[0] ?? "0.1.0";
const latestVersion = versions[versions.length - 1] ?? foundingVersion;

const deltaKeys = ["components", "categories", "tokens", "bindings"] as const;
type DeltaKey = (typeof deltaKeys)[number];
interface VersionDelta extends Record<DeltaKey, number> {
	prior: string | null;
}
const versionDeltas: Record<string, VersionDelta> = Object.fromEntries(
	versions.map((version, i) => {
		const prior = i > 0 ? versions[i - 1] : null;
		const cur = scopes[version] as Record<DeltaKey, number>;
		const prev = prior ? (scopes[prior] as Record<DeltaKey, number>) : null;
		const growth = Object.fromEntries(
			deltaKeys.map((k) => [k, prev ? cur[k] - prev[k] : 0]),
		) as Record<DeltaKey, number>;
		return [version, { prior, ...growth }];
	}),
);

const latestDeltas = versionDeltas[latestVersion] ?? ({ prior: null } as VersionDelta);
const stats = displayStats(site).map((s) => {
	const delta = latestDeltas[s.key as DeltaKey] ?? 0;
	return {
		key: s.key,
		num: `${s.value}`,
		label: s.label,
		deltaLabel: `+${delta}`,
		prior: latestDeltas.prior,
		move: delta > 0 && latestDeltas.prior ? "up" : "none",
	};
});
const addedByVersion: Record<string, number> = Object.fromEntries(advent.map((a) => [a.version, a.added]));
const bandComponents = all
	.filter((c) => (c.since ?? "0.1.0") !== foundingVersion)
	.sort(
		(a, b) =>
			compareVersions(b.since ?? "0.1.0", a.since ?? "0.1.0") || a.name.localeCompare(b.name),
	);
const currentAdded = addedByVersion[site.version] ?? 0;

const metaDescription = `The xtyle component contract: ${total} components across ${grouped.length} categories, each rendered live from the active xtyle-default theme with a live token-coverage check.`;
---

<Base
	title="Components"
	description={metaDescription}
>
	<header class="cx-head">
		<Stack gap={2} class="cx-head__lead">
			<Eyebrow tracking="wide">Reference</Eyebrow>
			<Heading level={1} size="3xl">Components</Heading>
			<Text size="lg" tone="muted" class="cx-lede">
				The whole <code>@xtyle/astro</code> contract, rendered from the live
				<code>xtyle-default</code> theme. Nothing on this page is a mockup.
				The manifest is the source of truth: every card, every reference page,
				every swatch below is generated from it. The coverage badge isn't a
				promise, it's a measurement: a per-component check that the algorithm
				produces every token the component asks for.
			</Text>
		</Stack>
		<Grid columns={4} gap={3} role="list" class="cx-stats">
			{stats.map((stat) => (
				<Card compact role="listitem" class="cx-stat">
					<Stat
						label={stat.label}
						delta={stat.deltaLabel}
						trend="up"
						caption={stat.prior ? `since v${stat.prior}` : undefined}
						data-cx-stat={stat.key}
						data-move={stat.move}
						class="cx-stat__stat"
					>{stat.num}</Stat>
				</Card>
			))}
		</Grid>
	</header>

	<div class="cx-search">
		<label class="cx-search__label" for="cx-q">Search components</label>
		<input
			id="cx-q"
			type="search"
			class="cx-search__input xtyle-control"
			placeholder="Search by name, purpose, or capability: try 'meter', 'dropdown', 'modal'..."
			autocomplete="off"
			data-search-input
		/>
		<div class="cx-version">
			<label class="cx-version__label" for="cx-since">Available as of</label>
			<select
				id="cx-since"
				class="cx-version__select xtyle-control"
				autocomplete="off"
				data-version-select
				data-latest={latestVersion}
			>
				{[...advent].reverse().map((a) => (
					<option value={a.version} selected={a.version === latestVersion}>{a.version} — {a.total} available</option>
				))}
			</select>
		</div>
		<p class="cx-search__status" data-search-status aria-live="polite" role="status"></p>
		<script is:inline type="application/json" data-version-scopes set:html={JSON.stringify(scopes)}></script>
		<script is:inline type="application/json" data-version-deltas set:html={JSON.stringify(versionDeltas)}></script>
	</div>

	<section class="cx-advent" aria-labelledby="cx-advent-title">
		<Stack gap={1}>
			<Heading level={2} size="md" id="cx-advent-title">How the set grew</Heading>
			<Text tone="muted" size="sm">
				Components introduced per release, with the running total. Pick a bar to filter the
				catalogue to what existed then.
			</Text>
		</Stack>
		<ol class="cx-advent__plot">
			{advent.map((a) => (
				<li class="cx-advent__col">
					<button
						type="button"
						class="cx-advent__bar-btn"
						data-advent-bar
						data-version={a.version}
						aria-label={`${a.version}: ${a.added} new, ${a.total} available in total`}
					>
						<span class="cx-advent__count">{a.added}</span>
						<span
							class="cx-advent__bar"
							style={`--h: ${a.first ? 100 : Math.round((a.added / peakAdded) * 100)}%`}
							data-seed={a.first ? "true" : undefined}
							data-latest={a.version === site.version ? "true" : undefined}
						/>
						<span class="cx-advent__tick">{a.version}</span>
						<span class="cx-advent__total">{a.total}</span>
					</button>
				</li>
			))}
		</ol>
		<Text tone="muted" size="xs" class="cx-advent__note">
			The first bar is the founding set, not a release that added that many at once.
		</Text>
	</section>

	<section
		class="cx-new"
		aria-labelledby="cx-new-title"
		data-new-band
		data-version={site.version}
		data-founding={foundingVersion}
		hidden={currentAdded === 0 ? true : undefined}
	>
		<div class="cx-new__head">
			<span class="cx-new__spark" aria-hidden="true">✦</span>
			<Heading level={2} size="lg" id="cx-new-title">New in <span data-new-version>v{site.version}</span></Heading>
			<Text size="sm" tone="muted" class="cx-new__blurb">
				<span data-new-blurb>
					{`${currentAdded} ${currentAdded === 1 ? "component" : "components"}`} landed this cycle. Each renders live below, from the same theme.
				</span>
			</Text>
		</div>
		<script is:inline type="application/json" data-new-counts set:html={JSON.stringify(addedByVersion)}></script>
		<Grid minColWidth="15rem" gap={4} align="stretch" class="cx-new__grid">
			{bandComponents.map((component) => {
				const cov = coverageFor(component);
				const since = component.since ?? "0.1.0";
				return (
				<article class="cx-new-card" data-new-card data-band-since={since} hidden={since !== site.version ? true : undefined}>
					<Card class="cx-new-card__inner">
						<Cluster justify="between" align="start" gap={2} class="cx-new-card__title">
							<Cluster gap={2} align="center">
								<Heading level={3} size="md">
									<a class="cx-card__link" href={`/components/${component.id}`}>{component.name}</a>
								</Heading>
								<Badge variant="solid" tone="success" size="sm">New</Badge>
							</Cluster>
							<CoverageMeter
								covered={cov.covered}
								missing={cov.missing}
								produced={producedCount}
								consumed={cov.consumed}
								peak={peakFootprint}
							/>
						</Cluster>
						<div class="cx-card__preview" aria-hidden="true" inert>
							<CardPreview id={component.id} />
						</div>
						<p class="cx-new-card__summary" set:html={renderMarkdownInline(component.summary)} />
					</Card>
				</article>
				);
			})}
		</Grid>
	</section>

	{grouped.map((group, gi) => {
		const groupCovered = group.items.filter(
			(c) => coverageFor(c).covered,
		).length;
		const groupHealthy = groupCovered === group.items.length;
		return (
		<section class="cx-section" id={group.meta.id} data-density={gi % 2 === 0 ? "roomy" : "tight"} data-cx-section>
			<header class="cx-section__head">
				<Cluster justify="between" align="baseline" gap={3} class="cx-section__headrow">
					<Cluster align="baseline" gap={2} class="cx-section__lead">
						<Heading level={2} size="xl">{group.meta.label}</Heading>
						<Text size="sm" tone="muted" class="cx-section__blurb">
							{group.meta.blurb}
						</Text>
					</Cluster>
					<Badge
						tone={groupHealthy ? "success" : "warn"}
						size="sm"
						title={`${groupCovered} of ${group.items.length} fully covered`}
						data-group-badge
					>
						{groupCovered}/{group.items.length}
					</Badge>
				</Cluster>
				<Separator />
			</header>
			<Grid minColWidth="18rem" gap={4} align="stretch" class="cx-grid">
				{group.items.map((component) => {
					const cov = coverageFor(component);
					return (
						<article
							class={`cx-card-link ${cov.covered ? "is-covered" : "has-gaps"}`}
							data-cx-card
							data-since={component.since ?? "0.1.0"}
							data-covered={cov.covered ? "true" : "false"}
							data-search={`${component.name} ${component.summary} ${(component.keywords ?? []).join(" ")} ${(component.seeAlso ?? []).join(" ")}`.toLowerCase()}
						>
							<Card interactive class="cx-card">
								<Cluster justify="between" align="start" gap={2} class="cx-card__top">
									<Cluster gap={2} align="center" class="cx-card__title">
										<Heading level={3} size="md" class="cx-card__name">
											<a class="cx-card__link" href={`/components/${component.id}`}>{component.name}</a>
										</Heading>
										{isNewComponent(component.since) ? (
											<Badge variant="solid" tone="success" size="sm">New</Badge>
										) : (
											<Badge variant="soft" tone="neutral" size="sm" class="cx-card__since">
												{component.since ?? "0.1.0"}
											</Badge>
										)}
									</Cluster>
									<CoverageMeter
										covered={cov.covered}
										missing={cov.missing}
										produced={producedCount}
										consumed={cov.consumed}
										peak={peakFootprint}
									/>
								</Cluster>
								<div class="cx-card__preview" aria-hidden="true" inert>
									<CardPreview id={component.id} />
								</div>
								<p
									class="cx-card__summary"
									set:html={renderMarkdownInline(component.summary)}
								/>
							</Card>
						</article>
					);
				})}
			</Grid>
		</section>
		);
	})}

	<p class="cx-search__empty" data-search-empty hidden>
		No components match that search. Try a capability word like
		<code>meter</code>, <code>dropdown</code>, or <code>modal</code>.
	</p>
</Base>

<script>
	const input = document.querySelector("[data-search-input]") as HTMLInputElement | null;
	const picker = document.querySelector("[data-version-select]") as HTMLSelectElement | null;
	const status = document.querySelector("[data-search-status]") as HTMLElement | null;
	const empty = document.querySelector("[data-search-empty]") as HTMLElement | null;
	const sections = Array.from(document.querySelectorAll("[data-cx-section]")) as HTMLElement[];
	const cards = Array.from(document.querySelectorAll("[data-cx-card]")) as HTMLElement[];
	const bars = Array.from(document.querySelectorAll("[data-advent-bar]")) as HTMLElement[];
	const groupBadges = Array.from(document.querySelectorAll("[data-group-badge]")) as HTMLElement[];
	const statHosts = Array.from(document.querySelectorAll("[data-cx-stat]")) as HTMLElement[];
	const statValue = (host: HTMLElement) => host.querySelector(".xtyle-stat__value") as HTMLElement | null;
	const newBand = document.querySelector("[data-new-band]") as HTMLElement | null;
	const total = cards.length;

	const scopeNode = document.querySelector("[data-version-scopes]");
	const scopes: Record<string, Record<string, number>> = scopeNode
		? JSON.parse(scopeNode.textContent ?? "{}")
		: {};
	const deltaNode = document.querySelector("[data-version-deltas]");
	const versionDeltas: Record<string, { prior: string | null } & Record<string, number>> = deltaNode
		? JSON.parse(deltaNode.textContent ?? "{}")
		: {};
	const liveStats = Object.fromEntries(
		statHosts.map((host) => [host.dataset.cxStat ?? "", Number.parseInt(statValue(host)?.textContent ?? "0", 10)]),
	);
	const currentVersion = newBand?.dataset.version ?? "";
	const foundingVersion = newBand?.dataset.founding ?? "";
	const latestVersion = picker?.dataset.latest ?? currentVersion;
	const newBandCards = Array.from(document.querySelectorAll("[data-new-card]")) as HTMLElement[];
	const newVersionEl = document.querySelector("[data-new-version]") as HTMLElement | null;
	const newBlurbEl = document.querySelector("[data-new-blurb]") as HTMLElement | null;
	const newCountsNode = document.querySelector("[data-new-counts]");
	const newCounts: Record<string, number> = newCountsNode
		? JSON.parse(newCountsNode.textContent ?? "{}")
		: {};

	/** Numeric, so 0.10.0 sorts above 0.9.0 rather than below it. */
	function compare(a: string, b: string) {
		const parse = (v: string) => v.split(".").map((n) => Number.parseInt(n, 10) || 0);
		const [x, y] = [parse(a), parse(b)];
		for (let i = 0; i < Math.max(x.length, y.length); i++) {
			const d = (x[i] ?? 0) - (y[i] ?? 0);
			if (d !== 0) return d;
		}
		return 0;
	}

	/**
	 * The two filters compose rather than replace: a search inside a pinned version keeps the pin, and
	 * clearing the search does not silently widen the version back to everything. Anything else makes
	 * one control quietly undo the other.
	 */
	function apply() {
		const q = (input?.value ?? "").trim().toLowerCase();
		const asOf = picker?.value ?? "";
		let visible = 0;
		for (const card of cards) {
			const since = card.dataset.since ?? "0.1.0";
			const matchesQuery = q === "" || (card.dataset.search ?? "").includes(q);
			const existedYet = asOf === "" || compare(since, asOf) <= 0;
			const match = matchesQuery && existedYet;
			card.hidden = !match;
			if (match) visible++;
		}
		for (const section of sections) {
			section.hidden = !section.querySelector("[data-cx-card]:not([hidden])");
		}
		if (empty) empty.hidden = visible !== 0;
		for (const bar of bars) {
			bar.setAttribute("aria-pressed", String(bar.dataset.version === asOf && asOf !== ""));
			const future = asOf !== "" && compare(bar.dataset.version ?? "0.1.0", asOf) > 0;
			bar.toggleAttribute("data-out-of-scope", future);
		}

		for (const badge of groupBadges) {
			const section = badge.closest("[data-cx-section]");
			if (!section) continue;
			const shown = Array.from(
				section.querySelectorAll("[data-cx-card]:not([hidden])"),
			) as HTMLElement[];
			const covered = shown.filter((c) => c.dataset.covered === "true").length;
			badge.textContent = `${covered}/${shown.length}`;
			badge.title = `${covered} of ${shown.length} fully covered`;
		}

		const scope = scopes[asOf] ?? liveStats;
		const deltas = versionDeltas[asOf];
		for (const host of statHosts) {
			const key = host.dataset.cxStat ?? "";
			const valueEl = statValue(host);
			if (valueEl && key in scope) valueEl.textContent = `${scope[key]}`;
			const grew = deltas?.[key] ?? 0;
			const prior = deltas?.prior ?? null;
			const moved = grew > 0 && prior !== null;
			host.dataset.move = moved ? "up" : "none";
			if (moved) {
				const numEl = host.querySelector(".xtyle-stat__delta")?.lastElementChild;
				if (numEl) numEl.textContent = `+${grew}`;
				const capEl = host.querySelector(".xtyle-stat__caption");
				if (capEl) capEl.textContent = `since v${prior}`;
			}
		}

		const active = asOf === "" ? currentVersion : asOf;
		const activeAdded = newCounts[active] ?? 0;
		const isFounding = active === foundingVersion;
		for (const card of newBandCards) card.hidden = card.dataset.bandSince !== active;
		if (newVersionEl) newVersionEl.textContent = `v${active}`;
		if (newBlurbEl) {
			newBlurbEl.textContent = isFounding
				? `The founding set: ${activeAdded} components. Every one is live in the catalogue below.`
				: `${activeAdded} ${activeAdded === 1 ? "component" : "components"} landed in v${active}. Each renders live below, from the same theme.`;
		}
		if (newBand) newBand.hidden = activeAdded === 0;
		if (status) {
			if (q === "" && asOf === latestVersion) status.textContent = "";
			else if (asOf === latestVersion) status.textContent = `${visible} of ${total} match`;
			else if (q === "") status.textContent = `${visible} of ${total} existed as of ${asOf}`;
			else status.textContent = `${visible} of ${total} match, as of ${asOf}`;
		}
	}

	input?.addEventListener("input", apply);
	picker?.addEventListener("change", apply);

	for (const bar of bars) {
		bar.addEventListener("click", () => {
			if (!picker) return;
			const version = bar.dataset.version ?? "";
			picker.value = picker.value === version ? latestVersion : version;
			apply();
		});
	}

	const params = new URLSearchParams(location.search);
	const initialQuery = params.get("q");
	const initialVersion = params.get("since");
	// INFO: browsers restore form state across reload and back-nav, so both controls are assigned
	// outright rather than only when a URL param is present.
	if (input) input.value = initialQuery ?? "";
	if (picker) {
		const known = initialVersion && Array.from(picker.options).some((o) => o.value === initialVersion);
		picker.value = known ? initialVersion : latestVersion;
	}
	apply();
</script>

<style>
	.cx-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-6);
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-6);
		border-bottom: var(--border-thin) solid var(--line);
	}
	@media (min-width: 60rem) {
		.cx-head {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
			align-items: end;
		}
	}
	.cx-head :global(.cx-lede) {
		max-width: 44rem;
	}
	.cx-lede code,
	.cx-card__summary code,
	.cx-search__empty code {
		font-size: 0.9em;
	}
	@media (min-width: 60rem) {
		.cx-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	/* Each stat's delta reads against the pinned version's own predecessor; a number that didn't move
	   that release carries no delta, so its trend and baseline caption are hidden for that pin. */
	.cx-stats :global([data-move="none"] .xtyle-stat__delta),
	.cx-stats :global([data-move="none"] .xtyle-stat__caption) {
		display: none;
	}

	.cx-new {
		margin-bottom: var(--space-8);
		padding: var(--space-5);
		border-radius: var(--radius-lg);
		border: var(--border-thin) solid var(--success);
		background: linear-gradient(to bottom right, var(--success-bg), transparent 72%);
	}
	.cx-new__head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		margin-bottom: var(--space-4);
	}
	.cx-new__spark {
		color: var(--success);
		font-size: var(--text-xl);
		line-height: 1;
	}
	.cx-new__blurb {
		margin: 0;
	}
	.cx-new-card {
		position: relative;
		display: flex;
	}
	.cx-new-card :global(.cx-new-card__inner) {
		position: relative;
		flex: 1;
		height: 100%;
		display: flex;
		flex-direction: column;
		box-shadow: var(--elevation-1);
		transition:
