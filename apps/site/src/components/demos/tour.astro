---
import Tour from "@xtyle/astro/Tour.astro";
import TourStep from "@xtyle/astro/TourStep.astro";
import Card from "@xtyle/astro/Card.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Cluster from "@xtyle/astro/Cluster.astro";
import Grid from "@xtyle/astro/Grid.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Text from "@xtyle/astro/Text.astro";
import Button from "@xtyle/astro/Button.astro";
import Field from "@xtyle/astro/Field.astro";
import Avatar from "@xtyle/astro/Avatar.astro";
import type { TourSpec } from "@xtyle/core";

const asData: TourSpec = {
	id: "tr-spec",
	title: "The same tour, as data",
	summary: "Three stops, no markup",
	steps: [
		{ target: "#tr-compose", heading: "Compose", body: "Declared in a variable, not in markup.", placement: "bottom" },
		{ target: "#tr-search", heading: "Search", body: "Which is what lets a help menu offer it by id.", placement: "bottom" },
		{ target: "#tr-settings", heading: "Settings", body: "Same rendering as a slotted tour, because it materializes the same steps.", placement: "left" },
	],
};
---

<div class="tr-demo" data-tour-demo>
	<Card>
		<Stack slot="header" gap={1}>
			<Heading level={2} size="body">Point at things, in order</Heading>
			<Text tone="muted" size="sm">
				One spotlight, re-aimed step by step, with Back / Next / Skip and a progress readout. Each
				target stays live underneath.
			</Text>
		</Stack>

		<Stack gap={5}>
			<div class="tr-demo__stage">
				<Cluster justify="between" align="center">
					<Cluster gap={2} align="center">
						<Avatar id="tr-avatar" tone="cyan" alt="Grace Hopper">GH</Avatar>
						<Text size="sm" weight="semibold">Grace's workspace</Text>
					</Cluster>
					<Button id="tr-compose" variant="solid" tone="accent" size="sm">Compose</Button>
				</Cluster>
				<Grid columns={2} gap={3}>
					<Field id="tr-search" label="Search" placeholder="Find anything" />
					<Cluster gap={2} justify="end" align="end">
						<Button id="tr-settings" variant="outline" tone="neutral" size="sm">Settings</Button>
					</Cluster>
				</Grid>
			</div>

			<Cluster gap={3}>
				<Button variant="solid" tone="accent" data-start-tour="tr-dots">Take the tour (dots)</Button>
				<Button variant="outline" tone="neutral" data-start-tour="tr-count">Take the tour (count)</Button>
					<Button variant="ghost" tone="neutral" data-start-tour="tr-spec">Take the tour (declared as data)</Button>
			</Cluster>

			<Stack gap={2}>
				<Text tone="muted" size="sm">
					A step can point at something that is not on screen yet. <code>beforeStep</code> runs before
					the target is resolved, so the step makes what it needs first; the callout opens straight
					away either way and attaches the target the moment it appears.
				</Text>
				<div id="tr-drawer" class="tr-demo__drawer" hidden>
					<Button id="tr-archive" variant="subtle" tone="neutral" size="sm">Archive</Button>
				</div>
				<Cluster gap={3}>
					<Button variant="solid" tone="accent" data-start-tour="tr-late">Take the tour (opens a drawer)</Button>
					<Text as="span" size="xs" tone="subtle" data-prepared-count>prepared 0 times</Text>
				</Cluster>
			</Stack>

			<Stack gap={2}>
				<Text tone="muted" size="sm">
					The spotlight knobs are the tour's to set once for every step: <code>dim</code> how dark the
					veil goes, <code>blur</code> how far the page behind it softens, <code>padding</code> how much
					room the hole leaves around a target, and <code>arrow</code> whether the pointer bounces,
					holds still, or is dropped. <code>scrollIntoView</code> brings a target that is off screen to
					the middle before its callout opens. Any step can still override its own.
				</Text>
				<Cluster gap={3}>
					<Button variant="outline" tone="neutral" data-start-tour="tr-look">Take the tour (dimmed and blurred)</Button>
				</Cluster>
			</Stack>
		</Stack>
	</Card>
</div>

<Tour id="tr-dots" progress="dots">
	<TourStep target="#tr-compose" heading="Start a message" placement="bottom">
		Everything begins here. The button still works while the tour points at it.
	</TourStep>
	<TourStep target="#tr-search" heading="Find anything" placement="bottom">
		Search across every thread, contact, and file.
	</TourStep>
	<TourStep target="#tr-avatar" heading="That's you" placement="right" shape="circle">
		Your account and status live behind your avatar.
	</TourStep>
	<TourStep target="#tr-settings" heading="Make it yours" placement="left" pulse="slow">
		Theme, shortcuts, and accounts. That's the tour.
	</TourStep>
</Tour>

<Tour id="tr-spec" progress="count" spec={asData} />

<Tour id="tr-late" progress="count">
	<TourStep target="#tr-compose" heading="Start here" placement="bottom">The drawer below is still closed.</TourStep>
	<TourStep target="#tr-archive" heading="Made on demand" placement="top">
		This button did not exist a moment ago; the step opened the drawer that holds it.
	</TourStep>
</Tour>

<Tour id="tr-look" progress="count" dim={0.9} blur={4} padding={16} arrow="static" scrollIntoView>
	<TourStep target="#tr-compose" heading="A heavier veil" placement="bottom">
		<code>dim</code> at 0.9 and <code>blur</code> at 4px, so the page behind reads as out of focus rather than merely darkened.
	</TourStep>
	<TourStep target="#tr-search" heading="More room, no bounce" placement="bottom">
		<code>padding</code> at 16px opens the hole well clear of the field, and <code>arrow="static"</code> points without animating.
	</TourStep>
	<TourStep target="#tr-settings" heading="Overridable per step" placement="left" pulse="fast">
		The tour sets the defaults; this step still takes its own <code>pulse</code>.
	</TourStep>
</Tour>

<Tour id="tr-count" progress="count">
	<TourStep target="#tr-compose" heading="Compose" placement="bottom">Where a new message begins.</TourStep>
	<TourStep target="#tr-search" heading="Search" placement="bottom">Find anything, fast.</TourStep>
	<TourStep target="#tr-settings" heading="Settings" placement="left">Theme, shortcuts, accounts.</TourStep>
</Tour>

<script>
	type TourEl = HTMLElement & {
		start(): void;
		beforeStep: ((index: number) => void | Promise<void>) | null;
	};
	for (const trigger of document.querySelectorAll<HTMLElement>("[data-start-tour]")) {
		trigger.addEventListener("click", () => {
			const id = trigger.dataset.startTour!;
			(document.getElementById(id) as TourEl | null)?.start();
		});
	}

	const late = document.getElementById("tr-late") as TourEl | null;
	const drawer = document.getElementById("tr-drawer");
	const readout = document.querySelector("[data-prepared-count]");
	let prepared = 0;
	if (late && drawer) {
		late.beforeStep = async (index) => {
			prepared += 1;
			if (readout) readout.textContent = `prepared ${prepared} time${prepared === 1 ? "" : "s"}`;
			drawer.hidden = index !== 1;
			await new Promise((resolve) => setTimeout(resolve, 120));
		};
		late.addEventListener("close", () => {
			drawer.hidden = true;
		});
	}
</script>

<style>
	.tr-demo__drawer {
		padding: var(--space-3);
		border-radius: var(--radius-md);
		background: var(--bg-2);
		border: var(--border-thin) solid var(--line);
	}
	.tr-demo__stage {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-4);
		border-radius: var(--radius-md);
		background: var(--bg-1);
		border: var(--border-thin) solid var(--line);
	}
</style>
