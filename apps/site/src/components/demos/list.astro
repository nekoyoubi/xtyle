---
import List from "@xtyle/astro/List.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Text from "@xtyle/astro/Text.astro";

const plans = [
	{ value: "starter", label: "Starter", lead: "circle", trail: "$0" },
	{ value: "pro", label: "Pro", lead: "check", trail: "$12", selected: true },
	{ value: "team", label: "Team", lead: "folder", trail: "$40" },
];

const files = [
	{ value: "readme", label: "README.md", lead: "folder", actions: [{ id: "delete", label: "Delete", icon: "close" }] },
	{ value: "index", label: "index.ts", lead: "folder", actions: [{ id: "delete", label: "Delete", icon: "close" }] },
	{ value: "styles", label: "styles.css", lead: "folder", actions: [{ id: "delete", label: "Delete", icon: "close" }] },
];

const settings = [
	{ value: "play", label: "Play", heading: true },
	{ value: "speed", label: "Text speed", trail: "Fast" },
	{ value: "music", label: "Music", checked: true },
	{ value: "display", label: "Display", heading: true },
	{ value: "scale", label: "Interface scale", trail: "100%" },
	{ value: "motion", label: "Reduce motion", checked: false },
	{ value: "danger", label: "Danger zone", heading: true, tone: "danger" },
	{ value: "wipe", label: "Erase all data" },
	{ value: "reset", label: "Reset settings" },
];

const saves = [
	{ value: "slot-1", label: "Slot 1", description: "Harbor district, day 12", trail: ["3h 40m", "Lv 14"], badge: { text: "latest", tone: "success" } },
	{ value: "slot-2", label: "Slot 2", description: "Northern pass, day 9", trail: ["2h 05m", "Lv 9"] },
	{ value: "slot-3", label: "Slot 3", description: "Old mine, day 31", trail: ["11h 12m", "Lv 27"], badge: [{ text: "locked", tone: "warn" }, "backup"] },
];

const pause = [
	{ value: "resume", label: "Resume", accelerator: "r" },
	{ value: "options", label: "Options", accelerator: "o" },
	{ value: "break", label: "", separator: true },
	{ value: "retire", label: "Retire", accelerator: "t", variant: "subtle" },
	{ value: "quit", label: "Quit", accelerator: "q", variant: "outline", tone: "danger" },
] as const;

const shop = [
	{ value: "rope", label: "Rope", trail: "12g" },
	{ value: "lantern", label: "Lantern", trail: "40g" },
	{ value: "map", label: "Old map", trail: "250g", trailTone: "danger" },
];

const nav = [
	{ value: "overview", label: "Overview", lead: "eye" },
	{ value: "install", label: "Install", lead: "gear" },
	{ value: "search", label: "Search the docs", lead: "search", trail: "⌘K" },
];
---

<Stack gap={6} class="demo">
	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Single-select</Heading>
		<Text size="sm" tone="muted">
			A <code>listbox</code>: arrow to move the cursor, Enter or click to choose. Lead icons and trailing
			text ride the item anatomy.
		</Text>
		<List label="Plan" interaction="selectable" selection="single" items={plans} />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Multi-select and range</Heading>
		<Text size="sm" tone="muted">
			Plain click replaces; <kbd>Ctrl</kbd>/<kbd>Cmd</kbd>-click toggles; with <code>selection="range"</code>,
			<kbd>Shift</kbd>-click extends a span. Under a high-contrast theme the selected rows gain a check.
		</Text>
		<div class="demo__row">
			<List label="Toppings" interaction="selectable" selection="multi" items="Cheese,Basil,Chili,Olives,Onion" />
			<List label="Days" interaction="selectable" selection="range" items="Mon,Tue,Wed,Thu,Fri" />
		</div>
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Sections, toggles and tones</Heading>
		<Text size="sm" tone="muted">
			An item with <code>heading: true</code> opens a labelled section; the cursor passes over it. An
			item with <code>checked</code> is a toggle row that leads with a check and announces its state, in
			whatever words <code>checkedLabel</code> and <code>uncheckedLabel</code> give it. A
			<code>tone</code> on a heading paints its whole section, and on an item paints that row.
		</Text>
		<List label="Settings" interaction="navigational" items={settings} checkedLabel="on" uncheckedLabel="off" />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Sections in columns</Heading>
		<Text size="sm" tone="muted">
			Each section's rows sit in a <code>group-items</code> part. Make <code>list</code> a grid and both
			<code>group</code> and <code>group-items</code> subgrids, and every section's rows share the same
			columns while one cursor walks them all.
		</Text>
		<List class="demo__columns" label="Settings" interaction="navigational" items={settings} />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Descriptions, badges and trailing fields</Heading>
		<Text size="sm" tone="muted">
			A <code>description</code> adds a second line, a <code>badge</code> a toned chip, and a list of
			<code>trail</code> fields becomes columns, each its own <code>trail-N</code> part to size.
		</Text>
		<List class="demo__saves" label="Saves" interaction="selectable" selection="single" items={saves} />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Variants, accelerators, separators and trail tones</Heading>
		<Text size="sm" tone="muted">
			A <code>variant</code> fills or rings a row in its tone, an <code>accelerator</code> underlines the key
			that takes it, a <code>separator</code> breaks a list without a heading, and <code>trailTone</code>
			inks only the trailing fields, like a price the player cannot afford.
		</Text>
		<div class="demo__row">
			<List label="Paused" interaction="navigational" items={pause} />
			<List label="Shop" interaction="navigational" items={shop} />
		</div>
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Navigational</Heading>
		<Text size="sm" tone="muted">A roving list of destinations: no persistent selection, each item activates.</Text>
		<List label="Jump to" interaction="navigational" items={nav} />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Actionable</Heading>
		<Text size="sm" tone="muted">Per-item actions appear on hover or focus; each emits a <code>list-action</code> event.</Text>
		<List label="Files" interaction="actionable" items={files} />
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Sizes</Heading>
		<div class="demo__row">
			<List label="Small" size="sm" interaction="selectable" selection="single" items="One,Two,Three" />
			<List label="Large" size="lg" interaction="selectable" selection="single" items="One,Two,Three" />
		</div>
	</section>
</Stack>

<style>
	.demo__group {
		display: grid;
		gap: var(--space-2);
	}
	.demo__row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
		align-items: start;
	}
	.demo :global(xtyle-list) {
		min-width: 12rem;
		max-width: 20rem;
		padding: var(--space-2);
		border: var(--border-thin) solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-1);
	}
	.demo :global(xtyle-list.demo__saves) {
		max-width: 28rem;
	}
	.demo :global(xtyle-list.demo__columns) {
		max-width: 32rem;
	}
	.demo :global(.demo__columns [part~="list"]),
	.demo :global(.demo__columns::part(list)) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--space-4);
	}
	.demo :global(.demo__columns [part~="group"]),
	.demo :global(.demo__columns::part(group)),
	.demo :global(.demo__columns [part~="group-items"]),
	.demo :global(.demo__columns::part(group-items)) {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: subgrid;
	}
	.demo :global(.demo__columns [part~="heading"]),
	.demo :global(.demo__columns::part(heading)) {
		grid-column: 1 / -1;
	}
	.demo :global(.demo__saves [part~="trail-1"]) {
		min-width: 4.5rem;
	}
	.demo :global(.demo__saves [part~="trail-2"]) {
		min-width: 3rem;
	}
</style>
