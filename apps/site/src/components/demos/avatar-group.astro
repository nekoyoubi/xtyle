---
import AvatarGroup from "@xtyle/astro/AvatarGroup.astro";
import Avatar from "@xtyle/astro/Avatar.astro";
import Card from "@xtyle/astro/Card.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Cluster from "@xtyle/astro/Cluster.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Text from "@xtyle/astro/Text.astro";
import Icon from "@xtyle/astro/Icon.astro";

const team = [
	{ name: "Ada Lovelace", initials: "AL", tone: "accent" as const },
	{ name: "Alan Turing", initials: "AT", tone: "success" as const },
	{ name: "Grace Hopper", initials: "GH", tone: "warn" as const },
	{ name: "Katherine Johnson", initials: "KJ", tone: "info" as const },
	{ name: "Edsger Dijkstra", initials: "ED", tone: "danger" as const },
];
const sizes = [
	{ name: "sm" as const, label: "Small" },
	{ name: "md" as const, label: "Medium (default)" },
	{ name: "lg" as const, label: "Large" },
	{ name: "xl" as const, label: "Extra large" },
];
const rings = [
	{ name: "Ember ring", tone: "red" as const, icon: "ember--flame" },
	{ name: "Tide ring", tone: "cyan" as const, icon: "tide--drop" },
	{ name: "Oak ring", tone: "green" as const, icon: "oak--leaf" },
	{ name: "Sun ring", tone: "yellow" as const, icon: "sun--sun" },
	{ name: "Storm ring", tone: "purple" as const, icon: "storm--bolt" },
];
const layouts = [
	{ label: 'layout="lattice"', layout: "lattice" as const, stack: undefined, spacing: "snug" as const, diamonds: true },
	{ label: 'layout="row"', layout: "row" as const, stack: undefined, spacing: undefined, diamonds: true },
	{ label: 'layout="wrap"', layout: "wrap" as const, stack: undefined, spacing: undefined, diamonds: false },
	{ label: 'stack="start"', layout: "overlap" as const, stack: "start" as const, spacing: undefined, diamonds: false },
];
const spacings = [
	{ name: "snug" as const, label: "Snug" },
	{ name: "normal" as const, label: "Normal (default)" },
	{ name: "loose" as const, label: "Loose" },
];
---

<Stack gap={6}>
	<Card>
		<Heading slot="header" level={3} size="sm">A contributor stack</Heading>
		<Stack gap={3}>
			<Text tone="muted" size="sm">
				Slot the avatars to show and set <code>overflow</code> to the number of people beyond them; the
				group overlaps the faces and caps the row with a <code>+N</code> chip. Each avatar keeps its own tone.
				Hover a covered avatar to raise it to the front.
			</Text>
			<AvatarGroup label="Contributors" overflow={12}>
				{team.map((p) => <Avatar alt={p.name} tone={p.tone}>{p.initials}</Avatar>)}
			</AvatarGroup>
		</Stack>
	</Card>

	<Card>
		<Heading slot="header" level={3} size="sm">Sizes</Heading>
		<Stack gap={4}>
			{
				sizes.map((s) => (
					<Cluster gap={3} align="center" justify="between">
						<AvatarGroup size={s.name} overflow={8} label={`${s.label} group`}>
							{team.slice(0, 3).map((p) => (
								<Avatar alt={p.name} tone={p.tone} size={s.name}>{p.initials}</Avatar>
							))}
						</AvatarGroup>
						<Text as="span" size="xs" tone="subtle" mono>size="{s.name}"</Text>
					</Cluster>
				))
			}
		</Stack>
	</Card>

	<Card>
		<Heading slot="header" level={3} size="sm">Spacing</Heading>
		<Stack gap={4}>
			{
				spacings.map((s) => (
					<Cluster gap={3} align="center" justify="between">
						<AvatarGroup spacing={s.name} label={`${s.label} spacing`}>
							{team.map((p) => (
								<Avatar alt={p.name} tone={p.tone}>{p.initials}</Avatar>
							))}
						</AvatarGroup>
						<Text as="span" size="xs" tone="subtle" mono>spacing="{s.name}"</Text>
					</Cluster>
				))
			}
		</Stack>
	</Card>

	<Card>
		<Heading slot="header" level={3} size="sm">Layouts</Heading>
		<Stack gap={4}>
			<Text tone="muted" size="sm">
				<code>layout</code> picks how the items sit. A <code>lattice</code> drops every other item half a step so
				diamonds nest edge to edge; <code>stack="start"</code> puts the first item on top of the pile.
			</Text>
			{
				layouts.map((l) => (
					<Cluster gap={3} align="center" justify="between">
						<AvatarGroup layout={l.layout} stack={l.stack} size="lg" spacing={l.spacing} label={`${l.label} layout`}>
							{l.diamonds
								? rings.map((r) => (
										<Avatar size="lg" shape="diamond" frame="solid" bevel tone={r.tone} alt={r.name}>
											<Icon slot="icon" name={r.icon} aria-hidden="true" />
										</Avatar>
									))
								: team.map((p) => <Avatar size="lg" alt={p.name} tone={p.tone}>{p.initials}</Avatar>)}
						</AvatarGroup>
						<Text as="span" size="xs" tone="subtle" mono>{l.label}</Text>
					</Cluster>
				))
			}
		</Stack>
	</Card>

	<Card>
		<Heading slot="header" level={3} size="sm">No overflow</Heading>
		<Stack gap={3}>
			<Text tone="muted" size="sm">
				Omit <code>overflow</code> (or set it to zero) and the group is just the overlapping faces, no chip.
			</Text>
			<AvatarGroup label="Reviewers">
				{team.slice(0, 3).map((p) => (
					<Avatar alt={p.name} tone={p.tone}>{p.initials}</Avatar>
				))}
			</AvatarGroup>
		</Stack>
	</Card>
</Stack>
