---
import Select from "@xtyle/astro/Select.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Grid from "@xtyle/astro/Grid.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Button from "@xtyle/astro/Button.astro";
import Cluster from "@xtyle/astro/Cluster.astro";
import Text from "@xtyle/astro/Text.astro";
---

<Stack gap={6} class="demo">
	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Labelled selects</Heading>
		<Grid minColWidth="15rem" gap={4}>
			<Select label="Timezone" name="tz">
				<option value="utc">UTC</option>
				<option value="est" selected>Eastern (UTC−5)</option>
				<option value="pst">Pacific (UTC−8)</option>
				<option value="cet">Central European (UTC+1)</option>
			</Select>
			<Select label="Theme" name="theme">
				<option value="auto" selected>Match system</option>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</Select>
		</Grid>
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">Sizes</Heading>
		<Grid minColWidth="12rem" gap={4} align="end">
			<Select label="Small" name="s-sm" size="sm">
				<option>One</option><option>Two</option><option>Three</option>
			</Select>
			<Select label="Medium" name="s-md" size="md">
				<option>One</option><option>Two</option><option>Three</option>
			</Select>
			<Select label="Large" name="s-lg" size="lg">
				<option>One</option><option>Two</option><option>Three</option>
			</Select>
		</Grid>
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">States</Heading>
		<Grid minColWidth="15rem" gap={4}>
			<Select label="Region" name="region" invalid error="Pick a region to continue.">
				<option value="" selected>Choose…</option>
				<option value="na">North America</option>
				<option value="eu">Europe</option>
			</Select>
			<Select label="Inherited" name="inherited" disabled>
				<option selected>Set by workspace</option>
			</Select>
		</Grid>
	</section>

	<section class="demo__group">
		<Heading level={2} size="sm" tone="muted">In a form</Heading>
		<Text size="sm" tone="muted">
			The chosen value posts once under its <code>name</code>, whether it rendered into light DOM or behind a shadow
			root. <code>required</code> is real constraint validity, so the browser blocks a submit with no plan chosen.
		</Text>
		<form id="demo-select-form">
			<Stack gap={3}>
				<Grid minColWidth="15rem" gap={4}>
					<Select label="Plan" name="plan" required>
						<option value="" selected>Choose…</option>
						<option value="team">Team</option>
						<option value="pro">Pro</option>
					</Select>
					<Select label="Billing" name="billing">
						<option value="monthly" selected>Monthly</option>
						<option value="yearly">Yearly</option>
					</Select>
				</Grid>
				<Cluster gap={2} align="center">
					<Button type="submit" size="sm">Subscribe</Button>
					<Text size="sm" tone="muted" id="demo-select-out">Nothing submitted yet.</Text>
				</Cluster>
			</Stack>
		</form>
	</section>
</Stack>

<script>
	import "@xtyle/core/elements";

	document.getElementById("demo-select-form")?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(event.target as HTMLFormElement);
		const shown = [...data.entries()].map(([key, value]) => `${key}=${String(value)}`).join(" · ");
		const out = document.getElementById("demo-select-out");
		if (out) out.textContent = shown.length > 0 ? `Submitted: ${shown}` : "Nothing submitted yet.";
	});
</script>

<style>
	.demo {
		width: 100%;
	}
	.demo__group {
		display: grid;
		gap: var(--space-3);
	}
</style>
