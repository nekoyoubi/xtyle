---
import Progress from "@xtyle/astro/Progress.astro";
import Card from "@xtyle/astro/Card.astro";
import Stack from "@xtyle/astro/Stack.astro";
import Cluster from "@xtyle/astro/Cluster.astro";
import Grid from "@xtyle/astro/Grid.astro";
import Heading from "@xtyle/astro/Heading.astro";
import Text from "@xtyle/astro/Text.astro";
import Avatar from "@xtyle/astro/Avatar.astro";
import { ACCENT_VARIANTS, HUES } from "@xtyle/core";

const tones = ["accent", "neutral", "info", "success", "warn", "danger"] as const;
const toneValue: Record<(typeof tones)[number], number> = {
	accent: 64,
	neutral: 40,
	info: 52,
	success: 100,
	warn: 78,
	danger: 22,
};

const TONE_GROUPS = [
	{ label: "Accents", tones: ["accent", ...ACCENT_VARIANTS, "neutral"] },
	{ label: "Statuses", tones: ["success", "info", "warn", "danger"] },
	{ label: "Named hues", tones: [...HUES] },
] as const;
---

<Stack gap={6}>
	<Card compact>
		<Heading slot="header" level={3} size="sm">Linear, six tones</Heading>
		<Stack gap={4}>
			{
				tones.map((tone) => (
					<Cluster gap={3} align="center" nowrap>
						<Text as="span" size="xs" tone="muted" class="demo-progress-label">{tone}</Text>
						<Progress tone={tone} value={toneValue[tone]} showValue aria-label={`${tone} progress`} class="demo-progress-bar" />
					</Cluster>
				))
			}
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Caption, reading, and note</Heading>
		<Stack gap={5}>
			<Text size="sm" tone="subtle">
				Two bars stacked in a panel are told apart by a screen reader and not by eye unless one of them says what it
				is. <code>label</code> renders the name and announces it; <code>reading</code> is free-form, so it can say
				things no value format could compute; <code>note</code> explains what the reading means.
			</Text>
			<Stack gap={4}>
				<Progress
					label="The haggle"
					reading="8 of 20 coins"
					note="They will come down another two, and no further."
					value={40}
					tone="accent"
				/>
				<Progress
					label="The stallkeep's patience"
					reading="thinning"
					note="Push once more and the price goes back up."
					value={22}
					tone="warn"
					ramp="thermal"
					reverse
				/>
				<Progress label="Standing in the market" reading="even" value={50} tone="info" />
			</Stack>
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Standing upright</Heading>
		<Stack gap={5}>
			<Text size="sm" tone="subtle">
				<code>orient="vertical"</code> grows the indicator up the block axis natively. Rotating a horizontal bar
				cannot be made correct from outside: a rotated element keeps its pre-rotation layout box, so its visible
				height is its pre-rotation width and no percentage resolves against the side you can see. The rail takes its
				length from <code>--xtyle-progress-length</code>, the way a ring takes its diameter from
				<code>--xtyle-progress-size</code>.
			</Text>
			<Cluster gap={5} align="end">
				{
					[
						{ label: "Hold", value: 82, tone: "success" as const },
						{ label: "Heat", value: 61, tone: "warn" as const },
						{ label: "Fuel", value: 34, tone: "info" as const },
						{ label: "Hull", value: 12, tone: "danger" as const },
					].map((gauge) => (
						<Progress
							orient="vertical"
							label={gauge.label}
							reading={`${gauge.value}%`}
							value={gauge.value}
							tone={gauge.tone}
							class="demo-progress-standing"
						/>
					))
				}
				<Progress orient="vertical" label="Mixed" reading="ramped" value={70} ramp="thermal" class="demo-progress-standing" />
				<Progress orient="vertical" label="Working" indeterminate aria-label="Working" class="demo-progress-standing" />
			</Cluster>
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Every tone</Heading>
		<Stack gap={4}>
			{TONE_GROUPS.map((group) => (
				<Stack gap={2}>
					<Text size="xs" tone="subtle" weight="semibold">{group.label}</Text>
					<Cluster gap={4} align="center">
						{group.tones.map((tone) => (
							<Stack gap={1}>
								<Text as="span" size="xs" tone="muted">{tone}</Text>
								<Progress tone={tone} value={62} aria-label={`${tone} progress`} />
							</Stack>
						))}
					</Cluster>
				</Stack>
			))}
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Value readouts</Heading>
		<Stack gap={4}>
			<Cluster gap={3} align="center" nowrap>
				<Text as="span" size="xs" tone="muted" class="demo-progress-label">percent</Text>
				<Progress tone="accent" size="lg" value={33} showValue valueFormat="percent" aria-label="Percent readout" class="demo-progress-bar" />
			</Cluster>
			<Cluster gap={3} align="center" nowrap>
				<Text as="span" size="xs" tone="muted" class="demo-progress-label">value</Text>
				<Progress tone="info" size="lg" value={123} max={456} showValue valueFormat="value" aria-label="Raw value readout" class="demo-progress-bar" />
			</Cluster>
			<Cluster gap={3} align="center" nowrap>
				<Text as="span" size="xs" tone="muted" class="demo-progress-label">of max</Text>
				<Progress tone="success" size="lg" value={123} max={456} showValue valueFormat="value-max" aria-label="Value over max readout" class="demo-progress-bar" />
			</Cluster>
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Thresholds, tone &amp; pulse</Heading>
		<Stack gap={4}>
			{
				[12, 38, 76].map((v) => (
					<Cluster gap={3} align="center" nowrap>
						<Text as="span" size="xs" tone="muted" class="demo-progress-label">{v}%</Text>
						<Progress size="lg" value={v} showValue colorizeValue aria-label={`Storage at ${v} percent`} class="demo-progress-bar">
							<threshold below="20" tone="danger" pulse="fast" />
							<threshold below="50" tone="warn" pulse="slow" />
							<threshold tone="success" />
						</Progress>
					</Cluster>
				))
			}
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Capacity meter (<code>role="meter"</code>)</Heading>
		<Stack gap={4}>
			{
				[
					{ name: "System", used: 910, total: 1000, free: "90 GB free of 1 TB" },
					{ name: "Media", used: 800, total: 2000, free: "1.2 TB free of 2 TB" },
					{ name: "Projects", used: 410, total: 500, free: "90 GB free of 500 GB" },
				].map((drive) => (
					<Stack gap={1}>
						<Cluster gap={2} align="center">
							<Text as="span" size="sm" weight="medium">{drive.name}</Text>
							<Text as="span" size="xs" tone="muted">{drive.free}</Text>
						</Cluster>
						<Progress meter value={drive.used} max={drive.total} showValue valueFormat="value-max" unit=" GB" colorizeValue aria-label={`${drive.name} capacity`} class="demo-progress-bar">
							<threshold below="75" tone="success" />
							<threshold below="90" tone="warn" />
							<threshold below="101" tone="danger" pulse="fast" />
						</Progress>
					</Stack>
				))
			}
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Value ramp (<code>ramp</code>)</Heading>
		<Stack gap={5}>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">Solid <code>thermal</code>, colored by value</Text>
				{
					[18, 42, 68, 88, 100].map((v) => (
						<Cluster gap={3} align="center" nowrap>
							<Text as="span" size="xs" tone="muted" class="demo-progress-label">{v}%</Text>
							<Progress ramp="thermal" value={v} showValue aria-label={`Load at ${v} percent`} class="demo-progress-bar" />
						</Cluster>
					))
				}
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">Gradient sweep (<code>ramp-mode="gradient"</code>, pure CSS)</Text>
				{
					[35, 70, 100].map((v) => (
						<Cluster gap={3} align="center" nowrap>
							<Text as="span" size="xs" tone="muted" class="demo-progress-label">{v}%</Text>
							<Progress ramp="thermal" rampMode="gradient" size="lg" value={v} aria-label={`Capacity sweep at ${v} percent`} class="demo-progress-bar" />
						</Cluster>
					))
				}
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">Palettes</Text>
				{
					(["intensity", "thermal", "severity", "accents", "skittles"] as const).map((palette) => (
						<Cluster gap={3} align="center" nowrap>
							<Text as="span" size="xs" tone="muted" class="demo-progress-label">{palette}</Text>
							<Progress ramp={palette} value={72} aria-label={`${palette} ramp`} class="demo-progress-bar" />
						</Cluster>
					))
				}
			</Stack>
			<Cluster gap={6} align="center">
				{
					[26, 58, 90].map((v) => (
						<Stack gap={2} align="center">
							<Progress variant="circular" ramp="thermal" value={v} showValue aria-label={`Ring at ${v} percent`} />
							<Text as="span" size="xs" tone="muted">{v}%</Text>
						</Stack>
					))
				}
			</Cluster>
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Inset readout</Heading>
		<Stack gap={4}>
			<Progress size="lg" value={66} showValue valuePosition="inset" aria-label="Inset readout at 66 percent" class="demo-progress-bar" />
			<Progress size="lg" tone="success" value={92} showValue valuePosition="inset" aria-label="Inset readout at 92 percent" class="demo-progress-bar" />
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Circular ring</Heading>
		<Cluster gap={6} align="center">
			{
				tones.map((tone) => (
					<Stack gap={2} align="center">
						<Progress variant="circular" tone={tone} value={toneValue[tone]} showValue aria-label={`${tone} progress`} />
						<Text as="span" size="xs" tone="muted">{tone}</Text>
					</Stack>
				))
			}
		</Cluster>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Groove, weight &amp; size (<code>track</code>, <code>thickness</code>)</Heading>
		<Stack gap={5}>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">A trackless ring as a portrait frame</Text>
				<Cluster gap={6} align="center">
					{
						[
							{ v: 34, tone: "danger" as const, who: "Ada Lovelace" },
							{ v: 72, tone: "warn" as const, who: "Grace Hopper" },
							{ v: 100, tone: "success" as const, who: "Alan Turing" },
						].map((p) => (
							<Stack gap={2} align="center">
								<div class="demo-portrait">
									<Avatar userName={p.who} size="lg" />
									<Progress variant="circular" value={p.v} track={false} thickness="5px" tone={p.tone} aria-label={`${p.who} profile ${p.v} percent complete`} />
								</div>
								<Text as="span" size="xs" tone="muted">{p.v}%</Text>
							</Stack>
						))
					}
				</Cluster>
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">Grooves: default, dropped (<code>track={false}</code>), toned</Text>
				<Cluster gap={6} align="center">
					{
						[
							{ label: "default", track: true as const },
							{ label: "none", track: false as const },
							{ label: "info", track: "info" as const },
							{ label: "warn", track: "warn" as const },
						].map((g) => (
							<Stack gap={2} align="center">
								<Progress variant="circular" value={62} track={g.track} showValue aria-label={`Groove ${g.label}`} />
								<Text as="span" size="xs" tone="muted">{g.label}</Text>
							</Stack>
						))
					}
				</Cluster>
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">One diameter, four weights (<code>thickness</code> in ring units)</Text>
				<Cluster gap={6} align="center">
					{
						[1, 2.5, 5, 9].map((t) => (
							<Stack gap={2} align="center">
								<Progress variant="circular" value={68} thickness={t} tone="accent" aria-label={`Ring weight ${t}`} />
								<Text as="span" size="xs" tone="muted">{t}</Text>
							</Stack>
						))
					}
				</Cluster>
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">One weight, three diameters (<code>--xtyle-progress-size</code> with an absolute <code>thickness</code>)</Text>
				<Cluster gap={6} align="center" class="demo-ring-scale">
					{
						[40, 72, 112].map((px) => (
							<Stack gap={2} align="center">
								<Progress variant="circular" value={68} thickness="6px" track="neutral" tone="accent" aria-label={`Ring at ${px} pixels`} style={`--xtyle-progress-size: ${px}px`} />
								<Text as="span" size="xs" tone="muted">{px}px</Text>
							</Stack>
						))
					}
				</Cluster>
			</Stack>
			<Stack gap={2}>
				<Text size="xs" tone="subtle" weight="semibold">Custom readout (the <code>value</code> slot)</Text>
				<Cluster gap={6} align="center">
					<Progress variant="circular" value={72} showValue aria-label="Sync, custom readout" style="--xtyle-progress-size: 88px" thickness="5px">
						<Text slot="value" as="span" size="xs" weight="semibold">72<br />done</Text>
					</Progress>
					<Progress size="lg" value={410} max={500} showValue aria-label="Storage, custom readout" class="demo-progress-bar">
						<Text slot="value" as="span" size="xs" tone="muted">410 GB of 500 GB</Text>
					</Progress>
				</Cluster>
			</Stack>
		</Stack>
	</Card>

	<Card compact>
		<Heading slot="header" level={3} size="sm">Sizes &amp; indeterminate</Heading>
		<Grid gap={5} minColWidth="240px">
			<Stack gap={3}>
				<Text as="span" size="xs" tone="subtle">Small</Text>
				<Progress tone="accent" value={48} size="sm" aria-label="Small progress" />
				<Text as="span" size="xs" tone="subtle">Medium</Text>
				<Progress tone="accent" value={48} aria-label="Medium progress" />
				<Text as="span" size="xs" tone="subtle">Large</Text>
				<Progress tone="accent" value={48} size="lg" showValue aria-label="Large progress" />
			</Stack>
			<Stack gap={3}>
				<Text as="span" size="xs" tone="subtle">Indeterminate — linear</Text>
				<Progress tone="info" indeterminate aria-label="Loading" />
				<Text as="span" size="xs" tone="subtle">Indeterminate — circular</Text>
				<Progress variant="circular" tone="info" indeterminate aria-label="Loading" />
			</Stack>
		</Grid>
	</Card>

	<Card>
		<Heading slot="header" level={3} size="sm">In a container that sizes to its content</Heading>
		<Stack gap={3}>
			<Text tone="muted" size="sm">
				A linear bar carries its own width, so it fills a table cell or a content-sized grid track
				rather than collapsing. Nothing here sets a width, and no <code>variant</code> is written:
				<code>linear</code> is the default and needs no attribute to be true.
			</Text>
			<table class="demo-progress-table">
				<tbody>
					<tr>
						<th scope="row"><Text as="span" size="sm">Charge</Text></th>
						<td><Progress meter size="sm" value={4.6} max={10} tone="success" aria-label="Charge" /></td>
					</tr>
					<tr>
						<th scope="row"><Text as="span" size="sm">Wear</Text></th>
						<td><Progress meter size="sm" value={8.2} max={10} tone="warn" aria-label="Wear" /></td>
					</tr>
				</tbody>
			</table>
		</Stack>
	</Card>
</Stack>

<style>
	.demo-progress-label {
		width: 4rem;
		flex: none;
	}
	.demo-progress-bar {
		flex: 1;
	}
	.demo-progress-standing {
		--xtyle-progress-length: 9rem;
	}
	.demo-portrait {
		position: relative;
		display: inline-flex;
		padding: 0.375rem;
	}
	.demo-progress-table {
		border-collapse: collapse;
		width: 100%;
	}
	.demo-progress-table th {
		width: 1%;
		white-space: nowrap;
		text-align: start;
		font-weight: var(--weight-regular);
		padding-inline-end: var(--space-4);
	}
	.demo-progress-table td {
		padding-block: var(--space-1);
	}
	.demo-portrait :global(xtyle-progress) {
		display: block;
		position: absolute;
		inset: 0;
		--xtyle-progress-size: 100%;
	}
</style>
